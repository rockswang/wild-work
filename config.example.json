{
  "listen": {
    "host": "127.0.0.1",
    "port": 7863
  },
  "api_key": "WildWorkAPI",
  "admin_password": "",
  "auth_dir": "./auths",
  "state_file": "./data/state.json",
  "region": "cn",
  "cooldown": {
    "hard_credit": "12h",
    "soft_rate": "60s",
    "err_threshold": 5,
    "err_cooldown": "10m"
  },
  "schedule": {
    "checkin_times": ["09:00", "21:00"],
    "keepalive_hours": [22]
  },
  "upstream": {
    "timeout_seconds": 120
  },
  "server": {
    "max_request_body_mb": 128
  },
  "login": {
    "lobsterai_callback_port": 0
  },
  "compat": {
    "default_channel": "workbuddy",
    "max_tokens_cap": 32000,
    "model_map": {
      "claude-*": "workbuddy/glm-5.2",
      "gpt-5*": "workbuddy/deepseek-v4-pro"
    }
  },
  "backup_proxy": "",
  "reasoning_efforts": {},
  "model_fallback": [],
  "custom_channels": [],
  "features": {
    "loop_guard": true
  },
  "updater": {
    "enabled": true,
    "auto_check": true,
    "check_interval_hours": 6,
    "repo": "rockswang/wild-work",
    "download_proxies": [
      "https://gh-proxy.com/",
      "https://ghfast.top/"
    ]
  }
}
